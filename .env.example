# Copy to .env.local for local dev. Set the first four in the Vercel dashboard,
# plus NEXT_PUBLIC_SITE_URL once the production domain exists.
# Never commit real values — .env* is gitignored.

# --- Supabase ---------------------------------------------------------------
# Both NEXT_PUBLIC_ vars are inlined into the client bundle at BUILD time, so
# they must exist in Vercel before the build runs, not just at runtime.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-publishable-key>

# Server-only. Bypasses RLS entirely — used by the public share page and the
# share ZIP download route. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- Mapbox -----------------------------------------------------------------
# Server-only. Forward + reverse geocoding. If this is missing, geocoding fails
# silently: address autofill does nothing AND every new project saves with
# location = null, which permanently breaks GPS auto-filing of photos.
MAPBOX_ACCESS_TOKEN=<mapbox-access-token>

# --- Site / SEO -------------------------------------------------------------
# The canonical production origin, e.g. https://siteline.app (no path, https).
# Drives robots.txt and sitemap.xml. Leave unset (or on a *.vercel.app host)
# and the site stays closed to search engines: robots.txt disallows everything
# and the sitemap is empty.
NEXT_PUBLIC_SITE_URL=
